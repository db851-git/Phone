# Copy to .env.local (dev) or set in your host's env vars (prod).

# PostgreSQL connection string. Get a free one from Vercel Postgres, Neon or Supabase.
# If unset, the site runs from data/products.json (read-only preview mode).
DATABASE_URL="postgresql://user:password@host:5432/phonepro?sslmode=require"

# Password for the /admin stock manager. If unset, defaults to "phonepro".
ADMIN_PASSWORD="change-me"
